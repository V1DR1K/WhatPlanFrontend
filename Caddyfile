:80 {
  encode zstd gzip
  root * /srv

  @assets path /assets/*
  @assetFiles {
    path /assets/*
    file
  }
  @api path /api/*

  route {
    handle @api {
      reverse_proxy whatplan-backend:8080
    }

    # Missing hashed assets must remain 404s, never SPA HTML responses.
    handle @assets {
      header @assetFiles Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    handle {
      try_files {path} /index.html
      header Cache-Control "no-cache, no-store, must-revalidate"
      file_server
    }
  }
}
