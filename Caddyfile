:80 {
  encode zstd gzip
  root * /srv

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https://image.tmdb.org; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self'"
  }

  @assets path /assets/*
  @assetFiles {
    path /assets/*
    file
  }
  @manifestFile {
    path /manifest.webmanifest
    file
  }
  @pwaIconFiles {
    path /icons/*
    file
  }
  @api path /api/*

  route {
    handle @api {
      reverse_proxy whatplan-backend:8080
    }

    # Missing hashed assets must remain 404s, never SPA HTML responses.
    handle @assets {
      header @assetFiles Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    handle @manifestFile {
      header Cache-Control "public, max-age=300, must-revalidate"
      file_server
    }

    handle @pwaIconFiles {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    handle {
      try_files {path} /index.html
      # Keep strict-script pages untouched by edge HTML injection (Cloudflare JSD/RUM).
      header Cache-Control "public, max-age=60, must-revalidate, no-transform"
      file_server
    }
  }
}
